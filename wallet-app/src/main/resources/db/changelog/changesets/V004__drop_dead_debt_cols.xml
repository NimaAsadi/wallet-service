<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <!-- The WalletDebt cascade only ever increments t2Tot0/t2Tot1/t1Tot0 debt; the
         credit/separ-credit debt counters (t2_to_credit_debt, t1_to_credit_debt,
         t2_to_separ_credit_debt, t1_to_separ_credit_debt) were never written. The
         event-sourced WalletState.Debt still models the 7 counters for shape parity,
         but the read-model wallet_debt table no longer needs the four dead columns. -->
    <changeSet id="12-drop-dead-debt-cols" author="pekko-rewrite">
        <dropColumn tableName="wallet_debt" columnName="t2_to_credit_debt"/>
        <dropColumn tableName="wallet_debt" columnName="t1_to_credit_debt"/>
        <dropColumn tableName="wallet_debt" columnName="t2_to_separ_credit_debt"/>
        <dropColumn tableName="wallet_debt" columnName="t1_to_separ_credit_debt"/>
    </changeSet>

</databaseChangeLog>
