<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <!-- ShedLock was a Spring-only distributed-lock for scheduled jobs. With the
         single-node Pekko Scheduler there are no cross-instance locks, so drop it. -->
    <changeSet id="9-drop-shedlock" author="pekko-rewrite">
        <dropTable tableName="shedlock"/>
    </changeSet>

</databaseChangeLog>
