<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <!-- Post-cutover cleanup: drop the legacy pekko-persistence-jdbc tables (created by V003) and
         the migration_progress table, now that the JDBC->R2DBC journal migration is complete.
         The R2DBC journal/snapshot/projection tables (V005, `pekko` schema) are NOT touched.
         ⚠ Deploy/run ONLY after verifying the cutover migration — these DROPs are irreversible.
         IF EXISTS keeps this a no-op on fresh environments that never had the JDBC tables. -->
    <changeSet id="13-drop-jdbc-persistence" author="r2dbc-migration" dbms="postgresql">
        <sqlFile path="db/changelog/sql/drop-jdbc-persistence.sql"
                 relativeToChangelogFile="false"
                 splitStatements="true"
                 stripComments="true"/>
    </changeSet>

</databaseChangeLog>
